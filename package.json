{
  "name": "sevendayshpc",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:public": "node tools/prepare-public.mjs",
    "dev": "npm run prepare:public && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "npm run prepare:public && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check:astro": "ASTRO_TELEMETRY_DISABLED=1 astro check --minimumSeverity error",
    "check:site": "node tools/check-site.mjs",
    "check": "npm run check:astro && npm run build && npm run check:site"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/starlight": "0.42.8",
    "astro": "7.4.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "katex": "^0.19.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^6.0.3"
  }
}
